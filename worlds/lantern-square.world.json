  "scripts": [
    {
      "id": "lantern-whisper",
      "roomId": "demo:lantern-square",
      "hooks": [
        "on_enter",
        "on_leave",
        "on_look",
        "on_use",
        "on_talk",
        "on_combat_start",
        "on_defeat",
        "on_timer",
        "on_quest_event"
      ],
      "capabilities": [
        "narrate",
        "set_flag"
      ],
      "limits": {
        "maxSourceBytes": 8192,
        "maxMemoryBytes": 1048576,
        "maxInstructions": 50000,
        "maxWallTimeMillis": 20,
        "maxEvents": 8,
        "maxEventFieldBytes": 512
      },
      "source": "function on_enter(ctx) tiamud.emit('set_flag', 'self', 'heard-lantern-whisper') end\nfunction on_leave(ctx) tiamud.emit('narrate', 'self', 'The blue lantern dims behind you.') end\nfunction on_look(ctx) if tiamud.random(2) == 1 then tiamud.emit('narrate', 'self', 'For a heartbeat, the lantern flame resembles a tiny dragon.') end end\nfunction on_use(ctx) end\nfunction on_talk(ctx) end\nfunction on_combat_start(ctx) end\nfunction on_defeat(ctx) tiamud.emit('narrate', 'self', 'The lantern flares as the struggle ends.') end\nfunction on_timer(ctx) end\nfunction on_quest_event(ctx) end"
    }
  ],
  "contentTests": [
    {
      "name": "authorized lantern flag changes prose without leaking author state",
      "roomId": "demo:lantern-square",
      "context": {
        "worldInstance": "primary",
        "worldTimePeriod": "day",
        "worldWeather": "clear",
        "worldTimeHour": 12,
        "actorLevel": 1,
        "actorIsAdmin": false,
        "actorFlags": [
          "heard-lantern-whisper"
        ]
      },
      "expect": {
        "descriptionContains": [
          "distant star"
        ],
        "outputExcludes": [
          "actor.flags",
          "demo:lantern-square",
          "heard-lantern-whisper",
          "lantern-awakened"
        ]
      }
    }
  ]
