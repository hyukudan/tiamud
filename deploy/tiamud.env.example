TIAMUD_HTTP_ADDR=127.0.0.1:8080
TIAMUD_TELNET_ADDR=0.0.0.0:4000
TIAMUD_TELNET_MODE=tls
TIAMUD_TELNET_TLS_CERT=/etc/tiamud/tls/fullchain.pem
TIAMUD_TELNET_TLS_KEY=/etc/tiamud/tls/privkey.pem
TIAMUD_TELNET_TLS_HANDSHAKE_TIMEOUT_SECONDS=10
TIAMUD_TELNET_MAX_PENDING_HANDSHAKES=128
# For an explicitly unencrypted private listener, set MODE=plaintext. The TLS
# identity variables are ignored and the server emits a prominent warning.
# Recommended public single-host profile. PostgreSQL runs on the same machine;
# this does not imply containers, clustering or dual writes. Provision the
# role/database and replace credentials according to the runbook.
TIAMUD_DATABASE_URL=postgresql://tiamud@127.0.0.1/tiamud?sslmode=require
# Zero-dependency local/legacy alternative: comment TIAMUD_DATABASE_URL and
# enable exactly this one setting instead.
# TIAMUD_DB_PATH=/var/lib/tiamud/data/tiamud.db
TIAMUD_WORLD_PACK=/var/lib/tiamud/worlds/lantern-square.world.json
TIAMUD_AUTH_ATTEMPTS_PER_MINUTE=10
TIAMUD_AUTH_BURST=5
TIAMUD_COMMANDS_PER_SECOND=12
TIAMUD_COMMAND_BURST=20
TIAMUD_MAX_SESSIONS_PER_ACCOUNT=4
TIAMUD_MAX_SESSIONS_PER_IP=16
RUST_LOG=tiamud_server=info,tower_http=info
# Optional single-player story sessions (ADR 0029). Disabled when unset;
# point it at a reviewed directory of *.story.json StoryPacks.
# TIAMUD_STORY_DIR=/opt/tiamud/stories
# TIAMUD_STORY_MAX_INSTANCES=256
# TIAMUD_STORY_IDLE_SECONDS=1800
# Optional Lua scripts in StoryPacks (ADR 0034). Off unless set to 1.
# TIAMUD_STORY_SCRIPTS=0
# TIAMUD_STORY_SCRIPT_BUDGET_MS=100
