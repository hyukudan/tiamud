{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tiamud:schema:story-pack:v1",
  "title": "Tiamud StoryPack v1",
  "description": "Structural schema of the canonical StoryPack v1 document. `tiamud-story validate` is authoritative: it also checks references, byte limits, nesting and effect budgets, value ranges and authoring lints. Optional fields are omitted rather than written as null in canonical form.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "id", "title", "start", "nodes"],
  "properties": {
    "format_version": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "title": { "$ref": "#/$defs/localizedText" },
    "start": { "$ref": "#/$defs/id" },
    "variables": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/variable" }
    },
    "items": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/item" }
    },
    "initial_inventory": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/id" }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/node" }
    }
  },
  "$defs": {
    "id": {
      "description": "Durable authored identifier: 1..=64 bytes of lowercase ASCII letters, digits, '-', '_' or '.', starting with a letter or digit.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "localizedText": {
      "description": "Locale tag to non-empty plain text. Labels allow at most 256 bytes and no newlines; node text allows 4096 bytes and newlines.",
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9-]{1,34}$" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "varInt": {
      "type": "integer",
      "minimum": -1000000000,
      "maximum": 1000000000
    },
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/localizedText" },
        "visible": { "type": "boolean" },
        "kind": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["int"],
              "properties": {
                "int": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["min", "max", "initial"],
                  "properties": {
                    "min": { "$ref": "#/$defs/varInt" },
                    "max": { "$ref": "#/$defs/varInt" },
                    "initial": { "$ref": "#/$defs/varInt" }
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["bool"],
              "properties": {
                "bool": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["initial"],
                  "properties": { "initial": { "type": "boolean" } }
                }
              }
            }
          ]
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/localizedText" }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "text": { "$ref": "#/$defs/localizedText" },
        "choices": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/choice" }
        },
        "ending": { "$ref": "#/$defs/ending" }
      }
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/localizedText" },
        "when": { "$ref": "#/$defs/condition" },
        "effects": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/effect" }
        },
        "target": { "$ref": "#/$defs/id" }
      }
    },
    "ending": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["victory", "defeat", "neutral"] }
      }
    },
    "conditionList": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/condition" }
    },
    "condition": {
      "description": "Closed condition AST. Nesting is limited to 8 levels and 64 nodes per tree.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["all"],
          "properties": { "all": { "$ref": "#/$defs/conditionList" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["any"],
          "properties": { "any": { "$ref": "#/$defs/conditionList" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["not"],
          "properties": { "not": { "$ref": "#/$defs/condition" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["var_cmp"],
          "properties": {
            "var_cmp": {
              "type": "object",
              "additionalProperties": false,
              "required": ["var", "op", "value"],
              "properties": {
                "var": { "$ref": "#/$defs/id" },
                "op": { "enum": ["eq", "ne", "lt", "le", "gt", "ge"] },
                "value": { "$ref": "#/$defs/varInt" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["has_item"],
          "properties": { "has_item": { "$ref": "#/$defs/id" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["visited"],
          "properties": { "visited": { "$ref": "#/$defs/id" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["flag"],
          "properties": { "flag": { "$ref": "#/$defs/id" } }
        }
      ]
    },
    "dice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "sides"],
      "properties": {
        "count": { "type": "integer", "minimum": 1, "maximum": 16 },
        "sides": { "type": "integer", "minimum": 2, "maximum": 100 },
        "modifier": { "type": "integer", "minimum": -1000000, "maximum": 1000000 }
      }
    },
    "rollTest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at_least"],
      "properties": {
        "at_least": { "$ref": "#/$defs/varInt" },
        "success": { "$ref": "#/$defs/id" },
        "failure": { "$ref": "#/$defs/id" }
      }
    },
    "effectList": {
      "type": "array",
      "items": { "$ref": "#/$defs/effect" }
    },
    "effect": {
      "description": "Closed effect DSL. A choice holds at most 64 effects counting nested `if` branches, nested at most 4 levels.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["set"],
          "properties": {
            "set": {
              "type": "object",
              "additionalProperties": false,
              "required": ["var", "value"],
              "properties": {
                "var": { "$ref": "#/$defs/id" },
                "value": {
                  "oneOf": [{ "type": "boolean" }, { "$ref": "#/$defs/varInt" }]
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["add"],
          "properties": {
            "add": {
              "type": "object",
              "additionalProperties": false,
              "required": ["var", "delta"],
              "properties": {
                "var": { "$ref": "#/$defs/id" },
                "delta": { "$ref": "#/$defs/varInt" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["give"],
          "properties": { "give": { "$ref": "#/$defs/id" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["take"],
          "properties": { "take": { "$ref": "#/$defs/id" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["goto"],
          "properties": { "goto": { "$ref": "#/$defs/id" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["roll"],
          "properties": {
            "roll": {
              "type": "object",
              "additionalProperties": false,
              "required": ["dice"],
              "properties": {
                "dice": { "$ref": "#/$defs/dice" },
                "modifier_var": { "$ref": "#/$defs/id" },
                "store": { "$ref": "#/$defs/id" },
                "test": { "$ref": "#/$defs/rollTest" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["if"],
          "properties": {
            "if": {
              "type": "object",
              "additionalProperties": false,
              "required": ["when"],
              "properties": {
                "when": { "$ref": "#/$defs/condition" },
                "then": { "$ref": "#/$defs/effectList" },
                "otherwise": { "$ref": "#/$defs/effectList" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["cue"],
          "properties": {
            "cue": {
              "oneOf": [
                { "const": "stop_music" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["music"],
                  "properties": {
                    "music": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["asset"],
                      "properties": { "asset": { "$ref": "#/$defs/id" } }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["sfx"],
                  "properties": {
                    "sfx": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["asset"],
                      "properties": { "asset": { "$ref": "#/$defs/id" } }
                    }
                  }
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["score"],
          "properties": {
            "score": { "type": "integer", "minimum": -1000000, "maximum": 1000000 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["end"],
          "properties": { "end": { "$ref": "#/$defs/ending" } }
        }
      ]
    }
  }
}
