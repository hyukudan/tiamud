  "characters": [
    {
      "id": "eva",
      "name": { "es": "Eva" },
      "portraits": { "neutral": "retrato-eva" },
      "default_expression": "sonrisa"
    }
  ],
  "nodes": [
    {
      "id": "sala",
      "text": { "es": "Una sala de pruebas." },
      "hotspots": [
        { "id": "mesa", "label": { "es": "Mesa" } },
        { "id": "caja", "label": { "es": "Caja" }, "when": { "flag": "nunca" } }
