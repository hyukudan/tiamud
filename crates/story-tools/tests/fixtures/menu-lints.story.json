        "entries": [
          {
            "id": "mirar-caja",
            "verb": "mirar",
            "target": "caja",
            "responses": [{ "id": "r", "blocks": [{ "text": { "es": "Una caja." } }] }]
          },
          {
            "id": "usar-fantasma",
            "verb": "usar",
            "target": "fantasma",
            "responses": [{ "id": "r", "blocks": [{ "text": { "es": "Imposible." } }] }]
          },
          {
            "id": "mirar-mesa",
            "verb": "mirar",
            "target": "mesa",
            "responses": [
              { "id": "siempre", "blocks": [{ "text": { "es": "Una mesa." } }] },
              { "id": "sombra", "blocks": [{ "text": { "es": "Nunca se ve." } }] }
            ],
            "exhausted": [{ "text": { "es": "Tampoco se ve." } }]
          },
          {
            "id": "hablar-eva",
            "verb": "hablar",
            "target": "eva",
            "responses": [
              {
                "id": "charla",
                "blocks": [{ "speaker": "eva", "text": { "es": "—Hola." } }],
                "dialogue": "charla"
              }
            ]
          },
          {
            "id": "usar-llave",
            "verb": "usar",
            "target": "llave",
            "responses": [
              {
                "id": "abrir",
                "when": { "flag": "nunca" },
                "blocks": [{ "text": { "es": "Se abre." } }],
                "target": "fin"
              },
              {
                "id": "salir",
                "blocks": [{ "text": { "es": "Sales." } }],
                "target": "fin"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "fin",
      "text": { "es": "Fin." },
      "ending": { "id": "fin", "kind": "neutral" }
    }
  ],
  "dialogues": [
    {
      "id": "charla",
      "start": "hola",
      "nodes": [
        {
          "id": "hola",
          "lines": [{ "speaker": "eva", "expression": "neutral", "text": { "es": "—¿Qué quieres?" } }],
          "options": [
            { "id": "adios", "label": { "es": "Adiós" } },
            {
              "id": "secreto",
              "label": { "es": "El secreto" },
              "when": { "flag": "nunca" },
              "next": { "goto": "perdido" }
