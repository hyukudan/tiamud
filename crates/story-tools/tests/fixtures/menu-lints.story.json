  "verbs": [
    {
      "id": "mirar",
      "label": { "es": "MIRAR" },
      "targets": "hotspot",
      "default": [{ "text": { "es": "Nada." } }]
    },
    {
      "id": "usar",
      "label": { "es": "USAR" },
      "targets": "item",
      "default": [{ "text": { "es": "No sirve." } }]
