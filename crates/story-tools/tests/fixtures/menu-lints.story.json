          ]
        },
        {
          "id": "perdido",
          "lines": [{ "speaker": "eva", "text": { "es": "—Nunca llegarás aquí." } }],
          "options": [{ "id": "volver", "label": { "es": "Volver" }, "next": "return" }]
        }
      ]
    },
    {
      "id": "huerfano",
      "start": "solo",
      "nodes": [
        {
          "id": "solo",
          "lines": [{ "text": { "es": "Nadie inicia este diálogo." } }],
          "options": [{ "id": "fuera", "label": { "es": "Salir" } }]
        }
      ]
    }
  ]
}
